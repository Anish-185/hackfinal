PORT=5000
CORS_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/coding_assessment

# Optional. Without it, jobs run in an in-process queue (single API instance only).
REDIS_URL=
# REDIS_URL=redis://127.0.0.1:6379
RUN_INLINE_WORKER=true
WORKER_CONCURRENCY=4

# ---- Judge0 ----
# Self-hosted (see ../judge0/README.md):
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
# Hosted on RapidAPI instead: set the URL and key below.
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
# Override language ids if your Judge0 instance differs (GET $JUDGE0_URL/languages).
# JUDGE0_LANG_PYTHON=71
# JUDGE0_LANG_JAVASCRIPT=63
# JUDGE0_LANG_JAVA=62
# JUDGE0_LANG_CPP=54

# ---- AI (Claude) ----
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Required for POST /api/challenges, /api/challenges/generate and /:id/validate (sent as x-admin-key).
ADMIN_API_KEY=
