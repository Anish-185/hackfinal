# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Postgres (read by the postgres container) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- Backend (api + worker) ---
# Hostnames are compose service names; use localhost when running outside compose.
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/app
REDIS_URL=redis://redis:6379/0

# --- Featherless LLM ---
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL_GENERATOR=
FEATHERLESS_MODEL_ASSISTANT=
FEATHERLESS_MODEL_PROBE=

# --- Frontend ---
# Set by docker-compose.yml; only needed when running the frontend outside compose.
# API_URL=http://localhost:8000
